<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Application.View.ChooseSitesPage"
			 xmlns:viewmodel="clr-namespace:Application.ViewModel">
    <ContentPage.BindingContext>
		<viewmodel:ChooseSitesViewModel/>
	</ContentPage.BindingContext>
    <!--<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Application.View"
             x:Class="Application.View.ChooseSitesPage">

        <ContentPage.BindingContext>
            <local:ChooseSitesViewModel />
        </ContentPage.BindingContext>-->

        <StackLayout>
            <ListView ItemsSource="{Binding Sites}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                        <ViewCell>
                            <StackLayout Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected}" />
                                <Label Text="{Binding Name}" VerticalOptions="Center" />
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Text="Save" 
                    Command="{Binding SaveSitesCommand}" 
                    TextColor="Black"
                    BackgroundColor="LightBlue"
                    Margin="40"/>
        </StackLayout>

</ContentPage>