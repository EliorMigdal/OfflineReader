<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Application.View.SettingsPage"
			 xmlns:viewmodel="clr-namespace:Application.ViewModel">
    <ContentPage.BindingContext>
        <viewmodel:SettingsViewModel/>
    </ContentPage.BindingContext>
    
    <Grid RowDefinitions="Auto, Auto"
          Margin="20"
          VerticalOptions="StartAndExpand">
        <Button Grid.Row="0"
                Text="Choose Sites" Command="{Binding ChooseSitesClickedCommand}" 
                TextColor="Black"
                BackgroundColor="LightBlue"
                Margin="15"/>
        <Button Grid.Row="1"
                Text="Auto download settings" Command="{Binding AutoDownloadClickedCommand}"
                TextColor="Black"
                BackgroundColor="LightBlue"
                Margin="15"/>
    </Grid>

</ContentPage>