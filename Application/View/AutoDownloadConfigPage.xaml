<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Application.View.AutoDownloadConfigPage"
             xmlns:viewmodel="clr-namespace:Application.ViewModel">
    <ContentPage.BindingContext>
        <viewmodel:AutoDownloadConfigViewModel/>
    </ContentPage.BindingContext>

    <StackLayout Padding="20">
        <!-- Auto Download Switch -->
        <Label Text="Enable Auto Download" />
        <Switch IsToggled="{Binding IsAutoDownloadEnabled}" />

        <!-- Time Lapse Picker with Hardcoded Items -->
        <Label Text="Select when to auto-download articles to device"
               FontSize="Small"
               Margin="10"
               HorizontalOptions="Center"/>
        <Picker Title="Time lapse options" 
                SelectedItem="{Binding SelectedHour}" 
                IsEnabled="{Binding IsAutoDownloadEnabled}">
            <Picker.Items>
                <x:String>Every 6 hours</x:String>
                <x:String>Every 12 hours</x:String>
                <x:String>Every 24 hours</x:String>
                <x:String>Every 2 days</x:String>
                <x:String>Every 3 days</x:String>
                <x:String>Every 4 days</x:String>
                <x:String>Every 5 days</x:String>
                <x:String>Every 1 week</x:String>
                <x:String>Every 2 weeks</x:String>
            </Picker.Items>
        </Picker>

        <!-- Time Lapse Picker with Hardcoded Items -->
        <Label Text="Select the starting hour of auto-download" 
               FontSize="Small"
               Margin="10"
               HorizontalOptions="Center"/>
        <Picker Title="Starting hour options">
            <!--SelectedItem="{Binding SelectedHour}" 
        IsEnabled="{Binding IsAutoDownloadEnabled}">-->
            <Picker.Items>
                <x:String>06:00 A.M.</x:String>
                <x:String>07:00 A.M.</x:String>
                <x:String>08:00 A.M.</x:String>
                <x:String>09:00 A.M.</x:String>
                <x:String>06:00 P.M.</x:String>
                <x:String>07:00 P.M.</x:String>
                <x:String>08:00 P.M.</x:String>
                <x:String>09:00 P.M.</x:String>
            </Picker.Items>
        </Picker>
    </StackLayout>
</ContentPage>






